{
  "name": "lunchmoney-mcp-server",
  "version": "0.4.7",
  "description": "Self-hostable remote MCP server for Lunch Money with built-in OAuth 2.1 — works with claude.ai custom connectors (mobile/web/desktop).",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Squixx/lunchmoney-mcp-server-oauth.git"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "scripts": {
    "start": "node server.mjs",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "node smoke-test.mjs"
  },
  "dependencies": {
    "@akutishevsky/lunchmoney-mcp": "2.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1"
  }
}

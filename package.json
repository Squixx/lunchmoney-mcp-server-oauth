{
  "name": "lunchmoney-mcp-server",
  "version": "0.6.16",
  "description": "Self-hostable remote MCP server for Lunch Money with built-in OAuth 2.1 — works with claude.ai custom connectors (mobile/web/desktop).",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Squixx/lunchmoney-mcp-server-oauth.git"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "start": "node server.mjs",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "node smoke-test.mjs"
  },
  "dependencies": {
    "@akutishevsky/lunchmoney-mcp": "3.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0"
  }
